# Copy to .env and adjust. All are optional.

# Port the API listens on (the client's Vite dev server proxies /api here).
PORT=5050

# Comma-separated origins allowed to call the API from a browser.
# Leave unset (or "*") to allow any origin.
# CORS_ORIGINS=http://localhost:5173,https://your-site.vercel.app

# Where the data comes from (src/providers/index.js). Only "files" exists today.
# DATA_PROVIDER=files

# Largest /timeseries response in values (areas x parameters x times); larger
# requests are refused with 400 invalid_query. The full data today is 19296.
# TIMESERIES_MAX_VALUES=500000

# Forecasts (GET /areas/:id/forecasts, see README "Forecasts").
# live = run the Python forecasting module in server/ml, falling back to the
# saved snapshots (npm run forecasts:build) if it cannot run; snapshot = never
# start Python, serve the saved snapshots only.
# FORECAST_MODE=live
# Python with the module installed. Default: server/ml/.venv/bin/python
# FORECAST_PYTHON=/path/to/python
# A run taking longer than this (ms) is stopped.
# FORECAST_TIMEOUT_MS=60000
# After a run that could not start or timed out, the same request is answered
# from the snapshot for this long (ms) before the module is tried again. 0 = off.
# FORECAST_RETRY_AFTER_MS=60000

# Earth Engine login for `npm run gee:check` / `npm run gee:extract`, which
# download the feature tables the forecasts run on (README "Forecasts"). The
# API itself never calls Earth Engine.
# Google Cloud project the requests run under (the team notebook's project).
# GEE_PROJECT=miicproject2
# Service-account JSON key, path relative to server/. Keep keys in
# server/secrets/ (git-ignored) and NEVER commit one. Unset = the login stored
# by `ml/.venv/bin/earthengine authenticate` on this machine.
# GEE_SERVICE_ACCOUNT_KEY=secrets/gee-key.json
# Or a personal login as an environment variable (for hosts where you can't run
# the browser sign-in): the CONTENTS of ~/.config/earthengine/credentials after
# `ml/.venv/bin/earthengine authenticate`. Acts as that Google account; treat it
# like a password. Used when GEE_SERVICE_ACCOUNT_KEY is not set.
# GEE_CREDENTIALS={"refresh_token":"..."}
