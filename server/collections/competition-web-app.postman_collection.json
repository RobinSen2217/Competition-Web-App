{
  "info": {
    "name": "Competition Web App API v1",
    "description": "REST API v1 serving the Competition Web App data (areas, parameters, timeseries, map layers and their values, forecasts, basemap). Full reference: server/docs/API.md. Set the baseUrl variable to point at another server. Expected status for each request is in its description.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5050",
      "type": "string"
    }
  ],
  "item": [
