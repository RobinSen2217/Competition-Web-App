              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "parameters"
              ]
            },
            "description": "Label, unit, decimals, aggregation and intervals of every series key. Expect 200."
          }
        },
        {
          "name": "Parameter",
