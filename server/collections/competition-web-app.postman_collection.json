      "name": "Service",
      "description": "Health and parameter catalog.",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "health"
              ]
            },
            "description": "Service status, versions and data timestamp. Expect 200. Never cached."
          }
        },
        {
          "name": "Parameters",
          "request": {
            "method": "GET",
