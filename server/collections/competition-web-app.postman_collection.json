    {
      "name": "Forecasts",
      "item": [
        {
          "name": "Forecast (defaults)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/areas/jaipur/forecasts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "areas",
                "jaipur",
                "forecasts"
              ]
            },
            "description": "NDVI, 12 months, every model (ridge, nn, gbm), computed from the area's Earth Engine table (data/gee/jaipur.features.csv, the team notebook's pipeline). The first request per area takes a few seconds while the models train; repeats come from the cache. data.source is \"live\", or \"snapshot\" when the Python module cannot run. Expect 200 once the area has been extracted (npm run gee:extract); before that 503 forecast_unavailable with details.reason \"no_gee_data\"."
          }
        },
        {
          "name": "Forecast (explicit query)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/areas/jaisalmer/forecasts?parameters=ndvi&horizon=12&models=ridge,nn,gbm&interval=monthly",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "areas",
                "jaisalmer",
                "forecasts"
              ],
              "query": [
                {
                  "key": "parameters",
                  "value": "ndvi"
                },
                {
                  "key": "horizon",
                  "value": "12"
                },
                {
                  "key": "models",
                  "value": "ridge,nn,gbm"
                },
                {
                  "key": "interval",
                  "value": "monthly"
                }
              ]
            },
            "description": "Same question written out: one parameter, horizon in months (1-24), models list. Jaisalmer is the notebook's own area. Expect 200 (503 no_gee_data until extracted)."
          }
        },
        {
          "name": "Forecast (one model, 6 months)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/areas/delhi/forecasts?horizon=6&models=gbm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "areas",
                "delhi",
                "forecasts"
              ],
              "query": [
                {
                  "key": "horizon",
                  "value": "6"
                },
                {
                  "key": "models",
                  "value": "gbm"
                }
              ]
            },
            "description": "Models always come back in the order ridge, nn, gbm. Expect 200 (503 no_gee_data until extracted)."
