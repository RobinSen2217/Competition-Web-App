# Copy to .env.local (git-ignored) to override locally, or set in Vercel's
# Environment Variables for production. Vite only exposes VITE_* variables.

# Base URL of the Express API, without a trailing /api.
# Leave unset to call /api on the same origin (in dev, Vite proxies /api to
# http://localhost:5050). In production point it at the hosted server, e.g.:
# VITE_API_URL=https://your-api.example.com
VITE_API_URL=
