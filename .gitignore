# Dependencies and build output
node_modules/
dist/

# Environment variables (secrets for the server go here, never commit them)
.env
.env.*
!.env.example

# Earth Engine service-account keys (GEE_SERVICE_ACCOUNT_KEY). Never commit a key.
server/secrets/

# Logs
*.log

# OS / editor / local tool files
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
.claude/

# Python virtual environment for the forecasting black box (rebuild with server/ml/requirements.txt)
server/ml/.venv/
__pycache__/
